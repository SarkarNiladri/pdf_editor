{
  "id": "/",
  "name": "PDF Suite",
  "short_name": "PDF Suite",
  "description": "Edit, convert, organise and secure PDFs from your phone or computer.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f5f6fb",
